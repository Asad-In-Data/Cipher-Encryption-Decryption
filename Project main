# Simple Encryption/Decryption System in MIPS Assembly
# Uses Caesar Cipher (shift cipher)
# Encrypts/decrypts letters only, preserves spaces and punctuation

.data
    # Menu strings
    menu:           .asciiz "\n=== Encryption/Decryption System ===\n1. Encrypt Message\n2. Decrypt Message\n3. Exit\nChoice: "
    prompt_msg:     .asciiz "Enter your message (max 100 chars): "
    prompt_key:     .asciiz "Enter shift key (1-25): "
    result_msg:     .asciiz "Result: "
    goodbye:        .asciiz "Goodbye!\n"
    newline:        .asciiz "\n"
    invalid:        .asciiz "Invalid choice!\n"
    
    # Buffers
    input_buffer:   .space 101      # 100 chars + null terminator
    output_buffer:  .space 101      # 100 chars + null terminator

.text
.globl main

main:
    # Main program loop
program_loop:
    # Display menu
    li $v0, 4
    la $a0, menu
    syscall
    
    # Get user choice
    li $v0, 5
    syscall
    move $t0, $v0           # Store choice in $t0
    
    # Check choice
    beq $t0, 3, exit_program
    beq $t0, 1, encrypt_mode
    beq $t0, 2, decrypt_mode
    
    # Invalid choice
    li $v0, 4
    la $a0, invalid
    syscall
    j program_loop

encrypt_mode:
    # Get message
    li $v0, 4
    la $a0, prompt_msg
    syscall
    
    li $v0, 8               # Read string
    la $a0, input_buffer
    li $a1, 101
    syscall
    
    # Get shift key
    li $v0, 4
    la $a0, prompt_key
    syscall
    
    li $v0, 5
    syscall
    move $s0, $v0           # Store key in $s0
    
    # Validate key (1-25)
    blt $s0, 1, program_loop
    bgt $s0, 25, program_loop
    
    # Encrypt the message
    jal encrypt_message
    
    # Display result
    li $v0, 4
    la $a0, result_msg
    syscall
    
    li $v0, 4
    la $a0, output_buffer
    syscall
    
    j program_loop

decrypt_mode:
    # Get message
    li $v0, 4
    la $a0, prompt_msg
    syscall
    
    li $v0, 8               # Read string
    la $a0, input_buffer
    li $a1, 101
    syscall
    
    # Get shift key
    li $v0, 4
    la $a0, prompt_key
    syscall
    
    li $v0, 5
    syscall
    move $s0, $v0           # Store key in $s0
    
    # Validate key (1-25)
    blt $s0, 1, program_loop
    bgt $s0, 25, program_loop
    
    # Decrypt the message (negate the key)
    sub $s0, $zero, $s0     # $s0 = -$s0
    
    # Encrypt with negative key (which decrypts)
    jal encrypt_message
    
    # Display result
    li $v0, 4
    la $a0, result_msg
    syscall
    
    li $v0, 4
    la $a0, output_buffer
    syscall
    
    j program_loop

# Subroutine: encrypt_message
# Encrypts input_buffer using Caesar cipher with key in $s0
# Result stored in output_buffer
encrypt_message:
    # Save registers
    addi $sp, $sp, -12
    sw $ra, 0($sp)
    sw $s1, 4($sp)
    sw $s2, 8($sp)
    
    # Initialize pointers
    la $s1, input_buffer    # Source pointer
    la $s2, output_buffer   # Destination pointer
    
encrypt_loop:
    # Load character
    lb $t0, 0($s1)          # Load byte from input
    
    # Check for null terminator or newline
    beqz $t0, encrypt_done
    beq $t0, 10, encrypt_done   # ASCII 10 = newline
    
    # Check if uppercase letter (A-Z)
    blt $t0, 65, not_upper
    bgt $t0, 90, not_upper
    
    # Encrypt uppercase letter
    sub $t0, $t0, 65        # Convert to 0-25
    add $t0, $t0, $s0       # Add shift
    
    # Handle wrap-around for positive shift
    bge $t0, 26, wrap_upper_pos
    blt $t0, 0, wrap_upper_neg
    j upper_done
    
wrap_upper_pos:
    sub $t0, $t0, 26        # Wrap around
    j upper_done
    
wrap_upper_neg:
    addi $t0, $t0, 26       # Wrap around
    
upper_done:
    addi $t0, $t0, 65       # Convert back to ASCII
    j store_char

not_upper:
    # Check if lowercase letter (a-z)
    blt $t0, 97, not_letter
    bgt $t0, 122, not_letter
    
    # Encrypt lowercase letter
    sub $t0, $t0, 97        # Convert to 0-25
    add $t0, $t0, $s0       # Add shift
    
    # Handle wrap-around for positive shift
    bge $t0, 26, wrap_lower_pos
    blt $t0, 0, wrap_lower_neg
    j lower_done
    
wrap_lower_pos:
    sub $t0, $t0, 26        # Wrap around
    j lower_done
    
wrap_lower_neg:
    addi $t0, $t0, 26       # Wrap around
    
lower_done:
    addi $t0, $t0, 97       # Convert back to ASCII
    j store_char

not_letter:
    # Keep character as is (space, punctuation, etc.)
    
store_char:
    # Store encrypted character
    sb $t0, 0($s2)
    
    # Move to next character
    addi $s1, $s1, 1
    addi $s2, $s2, 1
    
    j encrypt_loop

encrypt_done:
    # Add null terminator
    sb $zero, 0($s2)
    
    # Restore registers
    lw $ra, 0($sp)
    lw $s1, 4($sp)
    lw $s2, 8($sp)
    addi $sp, $sp, 12
    
    jr $ra

exit_program:
    # Print goodbye message
    li $v0, 4
    la $a0, goodbye
    syscall
    
    # Exit
    li $v0, 10
    syscall